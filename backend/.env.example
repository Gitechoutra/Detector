# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL 8 connection (database must already exist: CREATE DATABASE bank;)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/bank?charset=utf8mb4

# Long random strings, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_MINUTES=480

# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to 1 only when the backend runs behind one trusted reverse proxy (nginx etc.).
# Otherwise X-Forwarded-For is ignored: any client could send it to fake its IP.
TRUST_PROXY=0

# Predefined dummy accounts. Created by `flask db upgrade` and kept in sync with
# these values: change an email or password here, restart the backend (or run
# `flask seed`), and that account logs in with the new values. Accounts are
# matched by their fixed key, so changing an email never creates a duplicate.
SEED_RAHUL_EMAIL=rahul@demo.bank
SEED_RAHUL_PASSWORD=Rahul@123
SEED_KARAN_EMAIL=karan@demo.bank
SEED_KARAN_PASSWORD=Karan@123
SEED_PRIYA_EMAIL=priya@demo.bank
SEED_PRIYA_PASSWORD=Priya@123
SEED_AMIT_EMAIL=amit@demo.bank
SEED_AMIT_PASSWORD=Amit@123
SEED_QUICKCASH_EMAIL=quickcash@demo.bank
SEED_QUICKCASH_PASSWORD=Quick@123
SEED_SURESH_EMAIL=suresh@demo.bank
SEED_SURESH_PASSWORD=Suresh@123
SEED_ANALYST_EMAIL=analyst@demo.bank
SEED_ANALYST_PASSWORD=Detect@123
SEED_FRAUDER_EMAIL=frauder@demo.bank
SEED_FRAUDER_PASSWORD=Fraud@123
