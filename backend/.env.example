# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL 8 connection (database must already exist: CREATE DATABASE bank;)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/bank?charset=utf8mb4

# Long random strings, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_MINUTES=480

# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGINS=http://localhost:5173

# Viva / Demo Mode: exposes demo credentials, one-click scenarios and demo reset
# without login. Keep true for the viva, set false anywhere else.
DEMO_MODE_ENABLED=true
